# ─── API (apps/api) ────────────────────────────────────────────────
# Copy to apps/api/.env
#
# Everything here has a development default except the secrets and the provider
# details. For production: set NODE_ENV=production, replace both secrets, set the
# two public URLs to real addresses, and paste the four provider values.
DATABASE_URL=mysql://elimuar:elimuar_dev@127.0.0.1:3306/elimuar
PORT=4000
NODE_ENV=development

# Long random strings. Generate with: openssl rand -hex 32
# The API refuses to start in production with the defaults below still in place.
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
ACCESS_TOKEN_TTL=15m
# Refresh tokens are opaque and stored hashed; this is their lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded files live when no bucket is set (and profile pictures, logos).
STORAGE_DIR=./storage
# Public base URL used to build asset, picture and deep-link URLs returned to clients.
PUBLIC_API_URL=http://localhost:4000
# How long a signed /storage link stays valid, in seconds. Every page load and phone
# sync fetches a fresh link, so this only has to outlast one download. The signing key
# is derived from JWT_ACCESS_SECRET, so rotating that invalidates outstanding links too.
STORAGE_URL_TTL_SECONDS=3600
# The staff portal, used in every message the platform sends (invitations, activation).
PORTAL_URL=http://localhost:3000
# The HTTPS host that serves teacher App Links. Teacher invitations are emailed as
# https://<MOBILE_APP_URL>/teacher/invite/<token> so they open the mobile app;
# head teachers and school admins keep PORTAL_URL and stay on the web.
# This must match android:host in the app manifest and the host serving
# /.well-known/assetlinks.json.
MOBILE_APP_URL=https://app.elimuar.tz

# ─── Providers ─────────────────────────────────────────────────────
# Email is delivered by Resend (https://resend.com). Create an API key and paste
# it here; invitations, password resets and status notices go out as branded
# ElimuAR emails. Messages are written to the `notifications` outbox first, so
# nothing is lost while the key is empty — fill it in and the queue drains on
# the next send (or press "Send now" in the console).
#
# The from address must be a domain verified in your Resend account. The
# sandbox default `onboarding@resend.dev` only delivers to the Resend account
# owner, so invitations and resets silently fail for everyone else — replace it
# with an address on a verified domain before going live.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=ElimuAR <no-reply@your-verified-domain.tz>
#
# SMS rides a plain JSON endpoint (one message per POST): { "to": "+255…", "body": "…" }
# Any 2xx counts as delivered; anything else is recorded as failed with the
# provider's own error, visible in the console.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
#
# ─── AR content storage (the activity bundles and thumbnails) ──────
# Bundles are large, so they live in a Cloudflare R2 bucket (S3-compatible).
# Fill these five and every machine using them serves the same bundles. Left
# empty, files are kept on this machine under STORAGE_DIR instead.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=elimuar
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-<your-bucket-id>.r2.dev
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Uploading a bundle reads its manifest with Python (UnityPy) and makes the web
# preview's audio with ffmpeg. Point these at them if they are not on the PATH.
# PYTHON=python
# FFMPEG=ffmpeg

# ─── Seed data (development only) ──────────────────────────────────
# `npm run db:seed` creates the demonstration dataset. It deletes what is there,
# so it refuses to run when NODE_ENV=production unless allowed explicitly.
# Every login identity and secret below is read from here by the seed and by the
# QA scripts — none of them are compiled into the source. Choose your own values
# for local development; the seed refuses to run while the two secrets are empty.
SEED_ADMIN_EMAIL=admin@elimuar.go.tz
SEED_HEAD_EMAIL=head1@s0206.elimuar.tz
SEED_ACADEMIC_EMAIL=academic1@s0206.elimuar.tz
SEED_SECRETARY_EMAIL=secretary1@s0206.elimuar.tz
SEED_TEACHER_EMAIL=teacher1@s0206.elimuar.tz
SEED_UNCLAIMED_TEACHER_EMAIL=newteacher@s0206.elimuar.tz
SEED_STAFF_PASSWORD=
SEED_STUDENT_PIN=
SEED_ALLOW_PRODUCTION=false

# ─── WEB (apps/web) ────────────────────────────────────────────────
# Copy to apps/web/.env.local
# The browser talks to the Next.js server only; Next proxies /api/* to here.
API_ORIGIN=http://localhost:4000

      "steps": [
        {
          "id": "InputOutputDevicesObserve",
          "kind": "step",
          "title": "Observe",
          "description": "Observe how data goes into a computer, and how information comes out.",
          "imageName": null,
          "autoplayVO": true,
          "voClip": "ICT_Devices_Observe",
          "captions": [
            {
              "text": "A computer works in three stages: input, processing and output.",
              "duration": 6.21
            },
            {
              "text": "Input devices send data into the computer. They are how we give the computer instructions.",
              "duration": 8.418
            },
            {
              "text": "The keyboard lets us type letters, numbers and commands.",
              "duration": 5.13
            },
            {
              "text": "The mouse moves the pointer on the screen, so we can point, click and select.",
              "duration": 6.282
            },
            {
              "text": "A microphone turns our voice and other sounds into data the computer can store.",
              "duration": 6.018
            },
            {
              "text": "A webcam captures pictures and video, for example in an online class.",
              "duration": 6.042
            },
            {
              "text": "Inside the system unit, the CPU processes the data and turns it into information.",
              "duration": 6.834
            },
            {
              "text": "Output devices give that information back to us, in a form we can see, hear or hold.",
              "duration": 7.434
            },
            {
              "text": "The monitor shows text, pictures and video. It is soft copy output.",
              "duration": 7.218
            },
            {
              "text": "The printer puts information onto paper. This is called hard copy.",
              "duration": 6.618
            },
            {
              "text": "Speakers play sound, like music and voices.",
              "duration": 4.698
            },
            {
              "text": "Input goes in, processing happens inside, and output comes out. Now sort each device yourself.",
              "duration": 9.45
            },
            {
              "text": "Select Next to continue.",
              "duration": -1
            }
          ],
          "buttons": [
            {
              "id": "observe_replay",
              "text": "Replay",
              "active": true,
              "enabled": true
            }
          ],

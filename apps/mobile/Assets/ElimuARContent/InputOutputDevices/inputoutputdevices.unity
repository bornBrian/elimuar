  m_Script: {fileID: 11500000, guid: e88acdc6f1df5f1458437ecffad0ae55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ElimuAR.ActivityManifestAsset
  json: '{"format":"elimuar-activity/1","scenePath":"Assets/ElimuARContent/InputOutputDevices/inputoutputdevices.unity","rootPath":"InputOutputDevices_Root","settings":{"occlusion":false,"showDesk":true,"deskOffset":{"x":0,"y":0,"z":0}},"sections":[{"kind":"observe","section":11,"randomize":false,"maxSteps":-1,"steps":[{"id":"InputOutputDevicesObserve","kind":"step","title":"Observe","description":"Observe how data goes into a computer, and how information comes out.","imageName":null,"autoplayVO":true,"voClip":"ICT_Devices_Observe","captions":[{"text":"A computer works in three stages: input, processing and output.","duration":6.21},{"text":"Input devices send data into the computer. They are how we give the computer instructions.","duration":8.418},{"text":"The keyboard lets us type letters, numbers and commands.","duration":5.13},{"text":"The mouse moves the pointer on the screen, so we can point, click and select.","duration":6.282},{"text":"A microphone turns our voice and other sounds into data the computer can store.","duration":6.018},{"text":"A webcam captures pictures and video, for example in an online class.","duration":6.042},{"text":"Inside the system unit, the CPU processes the data and turns it into information.","duration":6.834},{"text":"Output devices give that information back to us, in a form we can see, hear or hold.","duration":7.434},{"text":"The monitor shows text, pictures and video. It is soft copy output.","duration":7.218},{"text":"The printer puts information onto paper. This is called hard copy.","duration":6.618},{"text":"Speakers play sound, like music and voices.","duration":4.698},{"text":"Input goes in, processing happens inside, and output comes out. Now sort each device yourself.","duration":9.45},{"text":"Select Next to continue.","duration":-1}],"buttons":[{"id":"observe_replay","text":"Replay","active":true,"enabled":true}],"confirmMoveOn":false,"confirm":{"title":"Ready to Move On?","content":"Are you ready to move to the next exercise?","confirm":"Continue to next exercise","cancel":"Cancel"},"countdown":{"duration":5,"text":"Moving on in..."},"objectPaths":["InputOutputDevicesObserve"]}]},{"kind":"explore","section":12,"randomize":false,"maxSteps":-1,"steps":[{"id":"InputOutputDevicesExplore","kind":"step","title":"Explore","description":"Sort the devices. Drag each one to its tray under INPUT or OUTPUT, and listen to what it does.","imageName":null,"autoplayVO":true,"voClip":null,"captions":[],"buttons":[{"id":"explore_reset","text":"Reset","active":true,"enabled":true}],"confirmMoveOn":true,"confirm":{"title":"Ready to Move On?","content":"Are you ready to show what you know?","confirm":"I''m Ready!","cancel":"Cancel"},"countdown":{"duration":5,"text":"Moving on in..."},"objectPaths":["InputOutputDevicesExplore3D"]}]},{"kind":"question","section":13,"randomize":true,"maxSteps":5,"steps":[{"id":"InputOutputDevicesEvaluate01","kind":"question","title":"Question","description":"Which of these is an input device?","imageName":null,"autoplayVO":true,"voClip":null,"captions":[],"buttons":[],"confirmMoveOn":false,"confirm":{"title":"Ready to Move On?","content":"Are you ready to move to the next exercise?","confirm":"Continue to next exercise","cancel":"Cancel"},"countdown":{"duration":5,"text":"Moving on in..."},"objectPaths":[],"question":{"randomizeAnswers":true,"correctHeader":"<b>Great job, ::ANSWER:: is correct!</b>","incorrectHeader":"<b>The correct answer is ::ANSWER::.</b>","correctFeedback":"","incorrectFeedback":"","answers":[{"text":"Keyboard","correct":true,"feedback":"","iconName":null},{"text":"Monitor","correct":false,"feedback":"","iconName":null},{"text":"Printer","correct":false,"feedback":"","iconName":null},{"text":"Speakers","correct":false,"feedback":"","iconName":null}]}},{"id":"InputOutputDevicesEvaluate02","kind":"question","title":"Question","description":"Which device gives hard copy output?","imageName":null,"autoplayVO":true,"voClip":null,"captions":[],"buttons":[],"confirmMoveOn":false,"confirm":{"title":"Ready to Move On?","content":"Are you ready to move to the next exercise?","confirm":"Continue to next exercise","cancel":"Cancel"},"countdown":{"duration":5,"text":"Moving on in..."},"objectPaths":[],"question":{"randomizeAnswers":true,"correctHeader":"<b>Great job, ::ANSWER:: is correct!</b>","incorrectHeader":"<b>The correct answer is ::ANSWER::.</b>","correctFeedback":"","incorrectFeedback":"","answers":[{"text":"Printer","correct":true,"feedback":"","iconName":null},{"text":"Monitor","correct":false,"feedback":"","iconName":null},{"text":"Projector","correct":false,"feedback":"","iconName":null},{"text":"Webcam","correct":false,"feedback":"","iconName":null}]}},{"id":"InputOutputDevicesEvaluate03","kind":"question","title":"Question","description":"What is the job of an output device?","imageName":null,"autoplayVO":true,"voClip":null,"captions":[],"buttons":[],"confirmMoveOn":false,"confirm":{"title":"Ready to Move On?","content":"Are you ready to move to the next exercise?","confirm":"Continue to next exercise","cancel":"Cancel"},"countdown":{"duration":5,"text":"Moving on in..."},"objectPaths":[],"question":{"randomizeAnswers":true,"correctHeader":"<b>Great job, ::ANSWER:: is correct!</b>","incorrectHeader":"<b>The correct answer is ::ANSWER::.</b>","correctFeedback":"","incorrectFeedback":"","answers":[{"text":"To give information from the computer to the user","correct":true,"feedback":"","iconName":null},{"text":"To put data into the computer","correct":false,"feedback":"","iconName":null},{"text":"To store programs permanently","correct":false,"feedback":"","iconName":null},{"text":"To process instructions","correct":false,"feedback":"","iconName":null}]}},{"id":"InputOutputDevicesEvaluate04","kind":"question","title":"Question","description":"A learner records her voice for a project. Which device does she use?","imageName":null,"autoplayVO":true,"voClip":null,"captions":[],"buttons":[],"confirmMoveOn":fal